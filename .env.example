# Optional AI provider keys. Leave empty to use local rule-based reports.

# OpenAI-compatible default
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4.1-mini

# Local server port
QUANT_AI_PORT=8787
APP_ENV=development
COOKIE_SECURE=0

# MySQL (required)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=marketbrief

# Waffo Pancake Pro monthly test subscription (the only two Waffo variables required)
WAFFO_MERCHANT_ID=
# Keep the PEM on one line and represent line breaks with literal \n:
# "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
WAFFO_PRIVATE_KEY=

# SMTP for login codes (if empty, codes are printed to server logs)
# Port 465 uses SSL; port 587 uses STARTTLS
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=1
SMTP_USE_TLS=0

# Daily brief notifications: email reuses SMTP; Pro users configure other
# channels in the workbench. Production must use an independent random key.
NOTIFICATION_ENCRYPTION_KEY=
