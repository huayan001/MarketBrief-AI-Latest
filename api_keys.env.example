# 在这里填写你的 AI API key。只需要填写你实际使用的平台。
# 复制本文件为 api_keys.env 后，保存文件并重新运行 run.bat 或 ./run.sh。

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4.1-mini

# 本地服务端口，通常不用改
QUANT_AI_PORT=8787
APP_ENV=development
COOKIE_SECURE=0

# MySQL（必填）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=marketbrief

# Waffo Pancake Pro 月度测试订阅（只需要这两个 Waffo 变量）
# Merchant ID：Dashboard → API & Development 页面顶部
WAFFO_MERCHANT_ID=
# Test API Key 下载的 RSA 私钥请写成单行，用字面量 \n 表示换行：
# "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
WAFFO_PRIVATE_KEY=

# SMTP 发验证码（未配置时验证码会打印到服务端日志，便于本地联调）
# 163/QQ 常用 465 + SSL；587 则用 STARTTLS
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=1
SMTP_USE_TLS=0

# 每日简报：邮件复用上面的 SMTP；其他渠道由 Pro 用户在工作台配置。
# 生产环境请生成独立随机值，例如：openssl rand -base64 32
NOTIFICATION_ENCRYPTION_KEY=
